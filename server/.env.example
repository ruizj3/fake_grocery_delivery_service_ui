# ============================================
# Database Configuration
# ============================================
# For a local PostgreSQL database:
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_NAME=fake_grocery_delivery
#   DB_USER=your_username
#   DB_PASSWORD=your_password
#   DB_SSL=false
#
# For a Render.com database, use the external connection string:
#   DATABASE_URL=postgresql://user:password@host:port/dbname
#   DB_SSL=true
# ============================================

# Option 1: Individual connection parameters (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fake_grocery_delivery
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Option 2: Full connection string (Render.com or other hosted DB)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# SSL — set to "true" for Render.com / hosted databases
DB_SSL=false

# Server
PORT=3001
